	(text "Note: Has been implemented as power-on reset using LATCH in DICE"
		(exclude_from_sim no)
		(at 113.03 108.204 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "35d2d643-4832-4956-a12f-2f3b4db2da03")
	)
	(text "Q is part of anti-tamper circuitry. Clever kids learned they could \nshuffle their feet on carpet, generate static electricity, and shock \nthe coin door to rack up points. They built circuitry to detect this,\nand pulse Q high so that the game would end.\n"
		(exclude_from_sim no)
		(at 113.284 101.6 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6a5a3d32-4466-4640-b3b7-87ba778c534a")
	)
	(text "P is apparently Atari's nomenclature here for \n\"Connect to logic high\" or \"P\"ositive, I'm assuming?"
		(exclude_from_sim no)
		(at 86.36 75.438 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "8bc40f56-2832-4fd6-a26b-9270889b1027")
	)
